{
  "name": "greek-catholic-almaty-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local:start": "npx --yes supabase@2.95.3 start",
    "db:local:stop": "npx --yes supabase@2.95.3 stop",
    "db:local:reset": "npx --yes supabase@2.95.3 db reset",
    "db:local:status": "npx --yes supabase@2.95.3 status",
    "env:use:local": "node scripts/switch-env.cjs local",
    "env:use:remote": "node scripts/switch-env.cjs remote"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
